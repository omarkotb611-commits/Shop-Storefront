{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist"
    },
    "shop-storefront": {
      "root": "artifacts/shop-storefront",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/healthz",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "shop-storefront"
      }
    }
  ]
}
